PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>
PREFIX rel2kg: <https://rel2kg.example/vocab#>

# Library people with no HR counterpart (same IRI or owl:sameAs).
# Expected: 2 rows (Tim Berners-Lee, Codd). Knuth is linked.

SELECT DISTINCT ?email
WHERE {
  GRAPH <https://rel2kg.example/graph/library> {
    ?person a rel2kg:Person ;
            schema:email ?email .
  }
  FILTER NOT EXISTS {
    GRAPH <https://rel2kg.example/graph/hr> {
      ?person a rel2kg:Person .
    }
  }
  FILTER NOT EXISTS {
    ?person (owl:sameAs|^owl:sameAs) ?other .
    GRAPH <https://rel2kg.example/graph/hr> {
      ?other a rel2kg:Person .
    }
  }
}
ORDER BY ?email
