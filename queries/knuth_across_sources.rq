PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>
PREFIX rel2kg: <https://rel2kg.example/vocab#>

# Knuth's campus department and library book only meet via owl:sameAs.
# Expected: 1 row.

SELECT ?department ?book
WHERE {
  ?campus schema:email "donald@campus.example" ;
          rel2kg:memberOf ?dept .
  ?dept schema:name ?department .
  ?campus (owl:sameAs|^owl:sameAs) ?publisher .
  ?bookIri schema:author ?publisher ;
           schema:name ?book .
}
