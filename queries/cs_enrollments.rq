PREFIX schema: <https://schema.org/>
PREFIX rel2kg: <https://rel2kg.example/vocab#>

# CS staff who are also enrolled in a course (HR ⋈ registrar).
# Expected: 5 rows (Ada, Alan×2, Grace, Edsger).

SELECT DISTINCT ?email ?courseCode
WHERE {
  ?person rel2kg:memberOf ?dept ;
          schema:email ?email .
  ?dept rel2kg:code "CS" .
  ?enrollment rel2kg:student ?person ;
              rel2kg:course ?course .
  ?course schema:courseCode ?courseCode .
}
ORDER BY ?email ?courseCode
